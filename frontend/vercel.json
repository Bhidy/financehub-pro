{
    "version": 2,
    "framework": "nextjs",
    "installCommand": "npm install --legacy-peer-deps",
    "buildCommand": "npm run build",
    "outputDirectory": ".next",
    "regions": [
        "fra1"
    ],
    "crons": [
        {
            "path": "/api/v1/watchdog/ping",
            "schedule": "0 6 * * *"
        },
        {
            "path": "/api/cron/cert-check",
            "schedule": "0 6 * * *"
        }
    ]
}
