#!/usr/bin/expect -f
set timeout 60
set ip "46.224.223.172"
set password "***REMOVED-CREDENTIAL***"
set prompt "#"

# Connect via SSH
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@$ip
expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    "$prompt" {
        send "cd /opt/starta\r"
    }
}
expect "$prompt"

# Create the test script inside the container using echo line by line to avoid Tcl bracket issues
send "echo 'import asyncio' > verify_compare_remote.py\r"
expect "$prompt"
send "echo 'import os' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo 'import sys' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo 'sys.path.append(\"/app\")' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo 'import logging' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo 'logging.basicConfig(level=logging.INFO)' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo 'from dotenv import load_dotenv' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo 'load_dotenv()' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo 'import asyncpg' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo 'from app.chat.handlers.compare_handler import handle_compare_stocks' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo 'DATABASE_URL = os.getenv(\"DATABASE_URL\")' >> verify_compare_remote.py\r"
expect "$prompt"

send "echo 'async def test_remote():' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo '    print(\"🚀 REMOTE TEST\")' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo '    try:' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo '        conn = await asyncpg.connect(DATABASE_URL)' >> verify_compare_remote.py\r"
expect "$prompt"
# AVOID BRACKETS:
send "echo '        symbols = list()' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo '        symbols.append(\"JUFO\")' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo '        symbols.append(\"DOMT\")' >> verify_compare_remote.py\r"
expect "$prompt"

send "echo '        result = await handle_compare_stocks(conn, symbols, language=\"ar\")' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo '        llm_text = getattr(result, \"conversational_text\", None) or result.get(\"conversational_text\")' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo '        if llm_text: print(\"✅ SAFE ACCESS SUCCESS\")' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo '    except Exception as e: print(f\"❌ ERROR: {e}\"); import traceback; traceback.print_exc()' >> verify_compare_remote.py\r"
expect "$prompt"
send "echo '    finally: await conn.close()' >> verify_compare_remote.py\r"
expect "$prompt"

send "echo 'if __name__ == \"__main__\": asyncio.run(test_remote())' >> verify_compare_remote.py\r"
expect "$prompt"

# Copy the script into the container
send "docker cp verify_compare_remote.py starta-backend-1:/app/verify_compare_remote.py\r"
expect "$prompt"

# Run the script inside the container
send "docker exec -it starta-backend-1 python3 /app/verify_compare_remote.py\r"
expect {
    "SAFE ACCESS SUCCESS" {
        send_user "\n✅ REMOTE TEST PASSED!\n"
    }
    "ERROR" {
        send_user "\n❌ REMOTE TEST FAILED!\n"
    }
}

expect "$prompt"
send "exit\r"
expect eof
