# Environment files — broad on purpose; secrets must never be committed.
backend/.env
.env
.env.*
.env*.local
!.env.example
!*/.env.example

# Vercel
# Ignore ALL .vercel directories. The canonical project link lives at
# root/.vercel (gitignored, one-time setup via `vercel link`). Never
# run `vercel` inside frontend/ — use ./scripts/deploy-web.sh instead.
.vercel

# Logs
*.log
logs/

# Debug artifacts
debug_*.html
debug_*.png

# Temporary files
# ⚠️ This global *.json ignore is a known foot-gun: any NEW json file the code
# needs (configs, data maps, locales) is silently kept out of git until it gets
# a `!` exception below. If you add a needed .json, add its exception HERE.
*.json
!package.json
!package-lock.json
!tsconfig.json
!yahoo_master_map.json
# Canonical primary nav — the build reads it, so it MUST be tracked.
!frontend/lib/nav.json
# Generated asset hash manifest — React imports it, so the build needs it.
!frontend/lib/asset-versions.json
system_backup_*

# --- repo hygiene (2026-06 cleanup) ---
# Python build cache (never commit)
__pycache__/
*.pyc
*.pyo
# Process id + log artifacts
*.pid
# Quarantined / archived trees — keep them out of the repo
/backend_archive_legacy/
/external-tools/
/db_export/
/testsprite_tests/
/scratch/
/Issues/
/launchingfinaltouches/
/implementation_plans/
# Local DB dumps only (source of truth is the cloud database).
# ⚠️ NEVER reinstate a global `*.sql` rule: it silently kept the FOUNDATIONAL
# schema migrations (0001_tradingview_egx & friends — the files that create
# market_tickers itself) out of git (audit Critical C2, 2026-06-11). Schema
# lives in backend-core/migrations/ and must ALWAYS be trackable by default.
*.dump.sql
backup_*.sql
db_backup_*.sql
# Agent tooling / skill caches — never belong in the product repo
/.agent/
/.shared/
# Secrets must never be committed (expect scripts, key dumps, env backups)
*.exp
.env.backup_critical
# macOS / debug artifacts
.DS_Store
debug_*.json

# Playwright MCP scratch output
.playwright-mcp/
.env*

# stray local screenshots (not part of the app)
fund-ar.jpeg
