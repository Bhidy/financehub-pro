#!/usr/bin/expect -f

set timeout 1200
set host [lindex $argv 0]
set password [lindex $argv 1]

spawn ssh -o StrictHostKeyChecking=no root@$host "cd /opt/starta && echo '--- BUILDING ---' && docker compose -f docker-compose.prod.yml build --build-arg CACHEBUST=[clock seconds] && echo '--- STARTING ---' && docker compose -f docker-compose.prod.yml up -d --force-recreate && echo '--- HEALTH CHECK ---' && sleep 10 && docker ps && echo '--- DONE ---'"

expect "password:"
send "$password\r"

expect {
    -exact "--- DONE ---" {
        send_user "\n✅ Emergency Start Completed.\n"
        exit 0
    }
    timeout {
        send_user "\n❌ Timeout waiting for start.\n"
        exit 1
    }
    eof
}
