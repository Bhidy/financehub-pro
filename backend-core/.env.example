# ============================================================================
# FinanceHub Pro - Backend Environment Variables
# ============================================================================

# Security
SECRET_KEY="" # MUST BE CHANGED IN PRODUCTION

# Database
DATABASE_URL="postgres://postgres:postgres@localhost:5432/financehub"

# AI Providers — Groq is the sole chat/LLM provider.
GROQ_API_KEY=""
# OPENAI_API_KEY is used ONLY for chat-memory embeddings (optional; degrades to a
# dummy embedding if unset). It is NOT a chat provider.
OPENAI_API_KEY=""

# Email
RESEND_API_KEY=""
FROM_EMAIL=""

# OAuth (Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://finhub-pro.vercel.app/api/auth/google/callback"
