# FinanceHub Pro - Base Image
# Contains: Python 3.11, System Libs, Key Python Packages (Torch, Playwright)
# Built rarely (monthly) to speed up daily deployments.

FROM python:3.11-slim

WORKDIR /app

# 1. System Dependencies
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# 2. Python Dependencies (Heavy)
# Copy requirements to cache them
COPY backend-core/requirements.txt .

# Install packages
RUN pip install --no-cache-dir -r requirements.txt

# 3. Playwright (Browser Engine)
# Install Playwright browsers (Chromium only to save space/time if possible, but full is safer for compat)
RUN playwright install --with-deps chromium

# 4. Pre-create directories structure
RUN mkdir -p /app/app /app/data /app/scripts /app/engine
