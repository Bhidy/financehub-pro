{
  "name": "frontend",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run verify:all",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check-types": "tsc --noEmit",
    "format": "prettier --write .",
    "pull-env": "vercel env pull .env.local",
    "verify": "npx tsx scripts/verify-prod.ts",
    "verify:routes": "node scripts/verify-route-aliases.mjs",
    "verify:i18n": "node scripts/verify-i18n-coverage.mjs",
    "verify:inputs": "node scripts/verify-build-inputs.mjs",
    "verify:all": "npm run verify:inputs && npm run verify:routes && npm run verify:i18n && npm run verify:nav && npm run verify:auth && npm run verify:funds && npm run verify:providers && npm run verify:pairs && npm run verify:glossary",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "seo:audit": "node scripts/seo/audit.mjs",
    "seo:audit:quick": "node scripts/seo/audit.mjs --quick --fail-on critical",
    "seo:indexnow": "node scripts/seo/indexnow.mjs --since 24h",
    "seo:gsc": "node scripts/seo/gsc.mjs --days 28",
    "seo:report": "node scripts/seo/audit.mjs --out /tmp/seo-audit.json; node scripts/seo/gsc.mjs --out /tmp/seo-gsc.json; node scripts/seo/report.mjs --audit /tmp/seo-audit.json --gsc /tmp/seo-gsc.json",
    "sync:mobile-public": "node scripts/sync-mobile-public.mjs",
    "build:mobile": "node scripts/sync-mobile-public.mjs && vite build --config vite.mobile.config.ts",
    "verify:nav": "npx tsx scripts/test-nav-gaps.ts && npx tsx scripts/test-range-integrity.ts scripts/fixtures/nav-dates-all.json",
    "verify:auth": "npx tsx scripts/test-auth-session.ts",
    "verify:funds": "npx tsx scripts/test-fund-categories.ts",
    "verify:providers": "npx tsx scripts/test-fund-providers.ts",
    "verify:pairs": "node scripts/test-stock-pairs.mjs",
    "verify:glossary": "npx tsx scripts/test-glossary.ts"
  },
  "dependencies": {
    "@capacitor/app": "8.1.0",
    "@capacitor/cli": "8.3.4",
    "@capacitor/core": "8.3.4",
    "@capacitor/ios": "8.3.4",
    "@capacitor/screen-orientation": "8.0.1",
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-table": "^8.21.3",
    "@types/react-big-calendar": "^1.16.3",
    "@types/three": "^0.183.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "apexcharts": "^5.3.6",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.27.1",
    "groq-sdk": "^0.37.0",
    "gsap": "^3.14.2",
    "lenis": "^1.3.17",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-apexcharts": "^1.9.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "19.2.3",
    "react-is": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "scroll-lock": "^2.1.5",
    "tailwind-merge": "^3.4.0",
    "technicalindicators": "^3.1.0",
    "ws": "^8.19.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "playwright": "^1.58.2",
    "prettier": "^3.7.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^50.1.3",
    "vite": "8.0.16"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
