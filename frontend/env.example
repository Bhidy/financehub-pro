# =====================================================
# FRONTEND ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values.
# Production values live in the Vercel `finhub` project env — see docs/CANONICAL_STATE.md.
# (Railway is legacy and no longer used; the backend is on Hetzner.)
# =====================================================

# Backend API URL (Hetzner backend, behind Caddy TLS)
NEXT_PUBLIC_API_URL=https://starta.46-224-223-172.sslip.io

# Database (server-side only; used by Next.js route handlers). Get from Vercel env or Supabase.
# DATABASE_URL=postgresql://...

# Google OAuth (login)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
