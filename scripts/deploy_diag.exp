#!/usr/bin/expect -f
set timeout 600
set timestamp [clock seconds]
spawn ssh root@46.224.223.172 "cd /opt/starta && git pull && docker compose down && docker system prune -af && CACHEBUST=$timestamp docker compose -f docker-compose.prod.yml build --no-cache && docker compose -f docker-compose.prod.yml up -d --force-recreate"
expect "password:"
send "StartaProd2026!\r"
expect eof
