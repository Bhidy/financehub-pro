# Dockerfile.coolify — self-contained image for Coolify (NO external base image).
#
# WHY THIS EXISTS:
# The production Dockerfile is `FROM starta-base:latest` — a custom base image built
# only on the Hetzner box and NOT pushed to any registry. Coolify builds from a clean
# git clone in an isolated builder and cannot see that image, so the normal Dockerfile
# fails there with "image not found". This file merges Dockerfile.base + Dockerfile
# into one self-contained build that Coolify (or any CI) can build from scratch.
#
# PREREQUISITE (BLOCKER): backend-core/requirements.txt MUST be committed to the repo.
# It is currently NOT tracked in git. Recover it from the box first:
#     ssh root@<server>  'docker run --rm starta-base:latest pip freeze' > backend-core/requirements.txt
#   then commit it. Without it, this build fails at the pip step.

FROM python:3.11-slim

WORKDIR /app
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PORT=7860

# 1. System dependencies (from Dockerfile.base)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc curl git \
    && rm -rf /var/lib/apt/lists/*

# 2. Python dependencies — copied first so Docker layer-caches them
COPY backend-core/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# 3. Playwright + Chromium (required by the EGX news scrapers)
RUN playwright install --with-deps chromium

# 4. Directory structure the app expects (engine is dev-only/empty in prod)
RUN mkdir -p /app/engine /app/data

# 5. Application code (matches the production Dockerfile's COPY set)
COPY backend-core/app ./app
COPY backend-core/scripts ./scripts
COPY backend-core/data_pipeline ./data_pipeline

EXPOSE 7860

# Run the API directly. (Bypasses run.sh, which exports a stale PYTHONPATH=/code
# left over from the old Hugging Face Spaces layout.)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7860"]
