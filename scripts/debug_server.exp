#!/usr/bin/expect

set timeout 20
set ip [lindex $argv 0]
set password [lindex $argv 1]

spawn ssh -o StrictHostKeyChecking=no root@$ip "uptime && docker ps --format '{{.Names}} {{.Status}}'"

expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    timeout {
        puts "Timeout waiting for response"
        exit 1
    }
    eof
}
