# Environment files — broad on purpose; secrets must never be committed.
backend/.env
.env
.env.*
.env*.local
!.env.example
!*/.env.example

# Vercel
# Ignore ALL .vercel directories. The canonical project link lives at
# root/.vercel (gitignored, one-time setup via `vercel link`). Never
# run `vercel` inside frontend/ — use ./scripts/deploy-web.sh instead.
.vercel

# Logs
*.log
logs/

# Debug artifacts
debug_*.html
debug_*.png

# Temporary files
# ⚠️ This global *.json ignore is a known foot-gun: any NEW json file the code
# needs (configs, data maps, locales) is silently kept out of git until it gets
# a `!` exception below. If you add a needed .json, add its exception HERE.
*.json
!package.json
!package-lock.json
!tsconfig.json
!yahoo_master_map.json
# Canonical primary nav — the build reads it, so it MUST be tracked.
!frontend/lib/nav.json
# Canonical auth-nav contract (session keys, account routes, nav labels).
# React imports it and the static mirror is generated from it — must be tracked.
!frontend/lib/auth-nav.json
# Generated asset hash manifest — React imports it, so the build needs it.
!frontend/lib/asset-versions.json
# Arabic twin routes, derived from app/ar/** — the build reads it.
!frontend/lib/ar-twin-routes.json
# Learn image dimensions, measured from the files — the build reads it.
!frontend/lib/learn-image-sizes.json
# Approved manager logo map — the build reads it.
!frontend/lib/manager-logos.json
# SEO operating-system data files read by scripts/seo/*.mjs AND by tests:
# the experiment ledger was silently untracked for weeks, so the Monday CI
# review ran against an empty ledger.
!frontend/content/seo-experiments.json
!frontend/content/search-intent-map.json
# Listing authority + fund-universe reconciliation (build inputs — lib/security-master.ts,
# lib/funds-hub-render.ts and the methodology page import them; docs/DATA_GOVERNANCE.md).
!frontend/content/egx-security-master.json
!frontend/content/fund-universe-reconciliation.json
!frontend/content/fund-taxonomy-overrides.json
!frontend/scripts/fixtures/egx-official-listed.json
!frontend/scripts/fixtures/egx-sme-listed.json
!frontend/scripts/fixtures/egx-security-overrides.json
!frontend/scripts/fixtures/tv-egypt-universe.json
!frontend/scripts/fixtures/platform-symbols.json
!frontend/scripts/fixtures/fra-fund-universe.json
system_backup_*

# --- repo hygiene (2026-06 cleanup) ---
# Python build cache (never commit)
__pycache__/
*.pyc
*.pyo
# Process id + log artifacts
*.pid
# Quarantined / archived trees — keep them out of the repo
/backend_archive_legacy/
/external-tools/
/db_export/
/testsprite_tests/
/scratch/
/Issues/
/launchingfinaltouches/
/implementation_plans/
# Local DB dumps only (source of truth is the cloud database).
# ⚠️ NEVER reinstate a global `*.sql` rule: it silently kept the FOUNDATIONAL
# schema migrations (0001_tradingview_egx & friends — the files that create
# market_tickers itself) out of git (audit Critical C2, 2026-06-11). Schema
# lives in backend-core/migrations/ and must ALWAYS be trackable by default.
*.dump.sql
backup_*.sql
db_backup_*.sql
# Agent tooling / skill caches — never belong in the product repo
/.agent/
/.shared/
# Secrets must never be committed (expect scripts, key dumps, env backups)
*.exp
.env.backup_critical
# macOS / debug artifacts
.DS_Store
debug_*.json

# Playwright MCP scratch output
.playwright-mcp/
.env*

# stray local screenshots (not part of the app)
fund-ar.jpeg
