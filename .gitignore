# Environment files
backend/.env
.env
.env.backup_critical
.env*.local

# Vercel
# Ignore all .vercel directories (created by `vercel link`) EXCEPT the
# committed frontend/.vercel/project.json which pins frontend/ to the
# canonical 'finhub' project. This means running `vercel` inside frontend/
# will ALWAYS target finhub (not create a stray project), making the
# two-project split-brain structurally impossible.
.vercel
!frontend/.vercel
!frontend/.vercel/project.json

# Logs
*.log
logs/

# Debug artifacts
debug_*.html
debug_*.png

# Temporary files
*.json
!package.json
!package-lock.json
!tsconfig.json
system_backup_*

# --- repo hygiene (2026-06 cleanup) ---
# Python build cache (never commit)
__pycache__/
*.pyc
*.pyo
# Process id + log artifacts
*.pid
# Quarantined / archived trees — keep them out of the repo
/backend_archive_legacy/
/external-tools/
/db_export/
/testsprite_tests/
/scratch/
/Issues/
/launchingfinaltouches/
/implementation_plans/
# Local DB dumps (source of truth is the cloud database)
*.sql
# Agent tooling / skill caches — never belong in the product repo
/.agent/
/.shared/
# Secrets must never be committed (expect scripts, key dumps, env backups)
*.exp
.env.backup_critical
# macOS / debug artifacts
.DS_Store
debug_*.json
